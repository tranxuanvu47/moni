# Khóa ShopAIKey không đặt ở đây.
# Sao chép src/config/ai.local.example.ts thành src/config/ai.local.ts
# rồi điền aiApiKey. File đó bị git bỏ qua và được gắn vào bản build.
#
# Model: src/config/ai.ts
# gpt-4o-mini cho phân tích, whisper-1 cho giọng nói.
# Base URL: https://api.shopaikey.com/v1
#
# Google Sheets: điền androidClientId và iosClientId trong src/config/google.local.ts.
# Không đưa client secret vào app. Redirect native:
# com.googleusercontent.apps.<client-id>:/oauth2redirect
# Điền client ID rồi build lại để gắn scheme.
